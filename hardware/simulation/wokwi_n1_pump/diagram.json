{
  "version": 1,
  "author": "NeerSync Hardware Team",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led_stat", "top": 100, "left": -80, "attrs": { "color": "blue" } },
    { "type": "wokwi-resistor", "id": "r_led", "top": 150, "left": -80, "attrs": { "value": "1000" } },
    { "type": "wokwi-potentiometer", "id": "pot_ct", "top": 220, "left": -100, "attrs": { "min": "0", "max": "200", "value": "15" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:D2", "r_led:1", "blue", [ "v0" ] ],
    [ "r_led:2", "led_stat:A", "blue", [ "v0" ] ],
    [ "led_stat:K", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot_ct:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot_ct:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot_ct:SIG", "esp:D36", "orange", [ "v0" ] ]
  ]
}
