{
  "version": 1,
  "author": "NeerSync Hardware Team",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "us_sensor", "top": -120, "left": -80, "attrs": { "distance": "285" } },
    { "type": "wokwi-pushbutton", "id": "btn_flow", "top": 150, "left": -80, "attrs": { "color": "blue" } },
    { "type": "wokwi-led", "id": "led_stat", "top": 240, "left": -80, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r_led", "top": 290, "left": -80, "attrs": { "value": "1000" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "us_sensor:VCC", "esp:5V", "red", [ "v0" ] ],
    [ "us_sensor:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "us_sensor:TRIG", "esp:D15", "green", [ "v0" ] ],
    [ "us_sensor:ECHO", "esp:D13", "yellow", [ "v0" ] ],
    [ "btn_flow:1.1", "esp:3V3", "red", [ "v0" ] ],
    [ "btn_flow:2.1", "esp:D35", "blue", [ "v0" ] ],
    [ "esp:D2", "r_led:1", "green", [ "v0" ] ],
    [ "r_led:2", "led_stat:A", "green", [ "v0" ] ],
    [ "led_stat:K", "esp:GND.1", "black", [ "v0" ] ]
  ]
}
