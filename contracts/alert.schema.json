{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jalsetu.gov.in/contracts/v1/alert.schema.json",
  "title": "JalSetuAlertV1",
  "description": "Authoritative contract for system anomalies, outages, and quality alarms.",
  "type": "object",
  "required": [
    "alert_id",
    "type",
    "severity",
    "scope",
    "reason",
    "created_ts",
    "status"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "pattern": "^ALT-[A-Za-z0-9_-]+$",
      "description": "Unique alert identifier (e.g. ALT-20261004-001 or UUID)."
    },
    "type": {
      "type": "string",
      "enum": [
        "no_supply",
        "low_pressure",
        "leakage",
        "quality",
        "node_offline",
        "chronic_nonfunctional"
      ],
      "description": "Standardized alert classification."
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Alert severity level."
    },
    "scope": {
      "type": "object",
      "required": ["gp", "branch"],
      "properties": {
        "gp": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]{4,8}$" },
            { "type": "integer", "minimum": 1000, "maximum": 99999999 }
          ],
          "description": "LGD Gram Panchayat code."
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Distribution network branch or DMA tag."
        },
        "fhtc_id": {
          "type": "string",
          "pattern": "^FHTC-[A-Z]{2}-[0-9]+-[0-9]{4,}$",
          "description": "Optional specific household tap connection affected."
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "description": "Human-readable diagnostic root cause or trigger condition."
    },
    "created_ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of alert occurrence."
    },
    "status": {
      "type": "string",
      "enum": ["active", "acknowledged", "resolved"],
      "description": "Operational lifecycle state."
    }
  },
  "additionalProperties": false
}
